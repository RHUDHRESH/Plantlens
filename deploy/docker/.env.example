# Copy to deploy/docker/.env and edit. Never commit the real .env.

# --- Server PC (compose.full.yml) ---------------------------------------------------------
# Long random strings. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PLANTLENS_DEV_JWT_SECRET=replace-with-a-long-random-string
GATEWAY_INGEST_TOKEN=replace-with-another-long-random-string
# Ports other PCs will use:  web UI http://<server-ip>:WEB_PORT , API http://<server-ip>:API_PORT
WEB_PORT=8080
API_PORT=8000
# Only matters when the web UI is opened from a different origin than the API (not the case
# with the bundled web container, which proxies /api on the same port).
WEB_ORIGIN=http://localhost:8080
# "dev" enables the bench role switcher (dev tokens). Anything else disables it.
PLANTLENS_ENV=dev

# --- Gateway (compose.full.yml --profile gateway, or compose.gateway.yml on another PC) ----
# modbus = RS-485 adapter, line = Arduino Uno streaming PL1/CSV over USB
GATEWAY_SERIAL_MODE=modbus
# Stable Linux path of the adapter:  ls -l /dev/serial/by-id/
GATEWAY_DEVICE=/dev/ttyUSB0
# Only for compose.gateway.yml on a different PC: where the server's API is.
PLANTLENS_SERVER_URL=http://192.168.1.50:8000
GATEWAY_ID=gw-1
