  "patterns": [
    {
      "pattern_id": "pump.cavitation_npsh",
      "version": "1.0.0",
      "failure_mode": "cavitation_npsh",
      "title": "Cavitation (insufficient NPSH available)",
      "category": "process",
      "severity": "warning",
      "description": "Suction pressure falls toward the fluid vapour pressure (low suction level, high fluid temperature, restricted suction or operation far right of BEP). Vapour bubbles form in the impeller eye and collapse on the vanes, causing noise, broadband high-frequency vibration, unstable head and erosion damage.",
      "typical_progression": "Seconds for noise and head instability; weeks to months for impeller erosion, which raises NPSHr and makes cavitation worse.",
      "required_roles": [
        "suction_pressure"
      ],
      "optional_roles": [
        "vibration_hf",
        "discharge_pressure",
        "flow",
        "fluid_temperature",
        "vibration",
        "power"
      ],
      "trigger_role": "suction_pressure",
      "symptoms": [
        {
          "role": "suction_pressure",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "Alarm on NPSHa/NPSHr margin rather than raw pressure; HI 9.6.1 recommends a margin ratio of 1.1–2.5 by application"
        },
        {
          "role": "vibration_hf",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            2000
          ],
          "weight": 0.9,
          "note": "Broadband 'gravel' noise"
        },
        {
          "role": "discharge_pressure",
          "direction": "oscillate",
          "onset_lag_ms": [
            0,
            2000
          ],
          "weight": 0.7,
          "note": "Head drop of 3 % defines NPSH3"
        },
        {
          "role": "flow",
          "direction": "oscillate",
          "onset_lag_ms": [
            0,
            5000
          ],
          "weight": 0.5
        },
        {
          "role": "fluid_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.3,
          "note": "A hotter liquid raises vapour pressure; may be the cause rather than an effect"
        },
        {
          "role": "vibration",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            10000
          ],
          "weight": 0.4
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "ps",
            "label": "Suction pressure ↓",
            "kind": "cause",
            "role": "suction_pressure"
          },
          {
            "id": "npsha",
            "label": "NPSHa ↓",
            "kind": "state"
          },
          {
            "id": "vap",
            "label": "Vapour cavities at impeller eye",
            "kind": "state"
          },
          {
            "id": "collapse",
            "label": "Bubble collapse on vanes",
            "kind": "symptom",
            "role": "vibration_hf"
          },
          {
            "id": "head",
            "label": "Head unstable / falls",
            "kind": "symptom",
            "role": "discharge_pressure"
          },
          {
            "id": "erode",
            "label": "Vane erosion (pitting)",
            "kind": "consequence"
          },
          {
            "id": "npshr",
            "label": "NPSHr ↑",
            "kind": "state"
          }
        ],
        "edges": [
          {
            "from": "ps",
            "to": "npsha",
            "sign": "+"
          },
          {
            "from": "npsha",
            "to": "vap",
            "sign": "-",
            "lag_ms": [
              0,
              1000
            ]
          },
          {
            "from": "vap",
            "to": "collapse",
            "sign": "+"
          },
          {
            "from": "vap",
            "to": "head",
            "sign": "-"
          },
          {
            "from": "collapse",
            "to": "erode",
            "sign": "+",
            "lag_ms": [
              604800000,
              15552000000
            ],
            "loop_id": "cavitation_damage"
          },
          {
            "from": "erode",
            "to": "npshr",
            "sign": "+",
            "loop_id": "cavitation_damage"
          },
          {
            "from": "npshr",
            "to": "vap",
            "sign": "+",
            "loop_id": "cavitation_damage"
          }
        ],
        "loops": [
          {
            "loop_id": "cavitation_damage",
            "polarity": "reinforcing",
            "description": "Erosion roughens and thins the vane inlet, raising NPSHr, so the pump cavitates at conditions it used to tolerate."
          }
        ]
      },
      "propagation": [
        {
          "relation": "driver",
          "effect_role": "current",
          "direction": "oscillate",
          "polarity": "any",
          "lag_ms": [
            0,
            2000
          ],
          "edge_type": "structural_load_effect",
          "note": "Unstable hydraulic torque modulates motor current"
        },
        {
          "relation": "process_downstream",
          "effect_role": "flow",
          "direction": "fall",
          "polarity": "+",
          "lag_ms": [
            0,
            5000
          ],
          "edge_type": "cause_to_effect",
          "note": "Delivered flow falls and fluctuates"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "pump.suction_strainer_blockage",
          "rule": "Strainer blockage: strainer ΔP rises first over hours to days, then suction pressure falls. Cavitation from low tank level or hot liquid has no strainer ΔP rise.",
          "first_role": "strainer_dp",
          "then_role": "suction_pressure"
        },
        {
          "vs_pattern": "pump.dry_run_loss_of_prime",
          "rule": "Cavitation keeps some flow and power with noisy head; dry running drops flow and power to near zero with no HF crackle once gas-locked."
        },
        {
          "vs_pattern": "pump.impeller_wear_recirculation",
          "rule": "Wear reduces head gradually at unchanged suction pressure and without HF broadband energy."
        }
      ],
      "signatures": [
        {
          "domain": "vibration_spectrum",
          "description": "Broadband high-frequency energy (typically 2–20 kHz) with random amplitude; vane pass component modulated.",
          "formula": "f_vp = Z_vanes × n / 60"
        },
        {
          "domain": "trend",
          "description": "Available NPSH from measured suction conditions",
          "formula": "NPSHa = (p_s,abs − p_v)/(ρ·g) + v_s²/(2·g) + z_s"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Compute NPSHa from suction pressure, liquid temperature (vapour pressure) and elevation; compare with NPSHr at the operating flow.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check suction vessel level, suction valve fully open and strainer ΔP.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Check the operating point against BEP; operation well right of BEP raises NPSHr.",
          "requires_isolation": false
        },
        {
          "order": 4,
          "text": "At the next opportunity inspect the impeller eye for pitting on the low-pressure side of the vanes.",
          "requires_isolation": true
        }
      ],
      "references": [
        "ANSI/HI 9.6.1 (NPSH margin)",
        "API 610 (centrifugal pumps)",
        "ISO 20816-7 (rotodynamic pump vibration)"
      ]
    },
    {
      "pattern_id": "pump.dry_run_loss_of_prime",
      "version": "1.0.0",
      "failure_mode": "dry_run_loss_of_prime",
      "title": "Dry running / loss of prime",
      "category": "process",
      "severity": "critical",
      "description": "The suction source is empty, a suction valve is shut, or gas has accumulated in the casing (vortexing, air leak into suction). The pump stops moving liquid: flow and head collapse, absorbed power drops sharply, and the mechanical seal and wear rings run without lubrication.",
      "typical_progression": "Seconds for flow and power; seal faces can be damaged within 30–60 s of true dry running.",
      "required_roles": [
        "flow"
      ],
      "optional_roles": [
        "discharge_pressure",
        "power",
        "suction_pressure",
        "seal_temperature",
        "casing_temperature",
        "vibration"
      ],
      "trigger_role": "flow",
      "symptoms": [
        {
          "role": "flow",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "threshold_hint": {
            "relative_to_nominal": 0.1,
            "for_ms": 3000
          },
          "note": "Near-zero flow"
        },
        {
          "role": "discharge_pressure",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            2000
          ],
          "weight": 0.9,
          "note": "Head collapses (unlike dead-head, where it rises to shut-off)"
        },
        {
          "role": "power",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            2000
          ],
          "weight": 0.9,
          "threshold_hint": {
            "relative_to_nominal": 0.5
          },
          "note": "Typically 30–50 % of rated; basis of power-monitor dry-run protection"
        },
        {
          "role": "suction_pressure",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            2000
          ],
          "weight": 0.4
        },
        {
          "role": "seal_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            10000,
            120000
          ],
          "weight": 0.6
        },
        {
          "role": "casing_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            30000,
            300000
          ],
          "weight": 0.4
        }
      ],
      "propagation": [
        {
          "relation": "driver",
          "effect_role": "current",
          "direction": "fall",
          "polarity": "+",
          "lag_ms": [
            0,
            2000
          ],
          "edge_type": "structural_load_effect",
          "note": "Motor unloads to near no-load current"
        },
        {
          "relation": "process_downstream",
          "effect_role": "flow",
          "direction": "fall",
          "polarity": "+",
          "lag_ms": [
            0,
            5000
          ],
          "edge_type": "cause_to_effect"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "pump.dead_head_blocked_discharge",
          "rule": "Dry run: discharge pressure collapses and power falls steeply. Dead-head: discharge pressure rises to shut-off head."
        },
        {
          "vs_pattern": "pump.cavitation_npsh",
          "rule": "Cavitation keeps partial flow with noisy head; dry running drops flow and power to near zero."
        },
        {
          "vs_pattern": "induction_motor.coupling_or_belt_slip",
          "rule": "A failed coupling also unloads the motor, but pump speed falls to zero while suction pressure stays normal."
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Check suction vessel level and suction valve position.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check for air ingress on the suction side (flanges, packing, vortexing at low submergence).",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Vent and re-prime the casing per the site procedure before any restart.",
          "requires_isolation": true
        },
        {
          "order": 4,
          "text": "After a confirmed dry run, check the seal for leakage on restart.",
          "requires_isolation": false
        }
      ],
      "references": [
        "API 682 (seal operation limits)",
        "API 610"
      ]
    },
    {
      "pattern_id": "pump.dead_head_blocked_discharge",
      "version": "1.0.0",
      "failure_mode": "dead_head_blocked_discharge",
      "title": "Dead-head / blocked discharge",
      "category": "process",
      "severity": "critical",
      "description": "The discharge path is closed (closed valve, stuck check valve, blocked line) while the pump runs. Head rises to shut-off, flow falls to zero, absorbed power falls to the shut-off value, and nearly all of it heats the trapped liquid until it flashes.",
      "typical_progression": "Seconds for pressure and flow; minutes for the liquid to heat to vaporisation (faster on high-energy pumps).",
      "required_roles": [
        "flow",
        "discharge_pressure"
      ],
      "optional_roles": [
        "power",
        "casing_temperature",
        "vibration",
        "seal_temperature"
      ],
      "trigger_role": "flow",
      "symptoms": [
        {
          "role": "flow",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "threshold_hint": {
            "relative_to_nominal": 0.1,
            "for_ms": 3000
          }
        },
        {
          "role": "discharge_pressure",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            2000
          ],
          "weight": 0.9,
          "note": "Approaches the shut-off head on the pump curve"
        },
        {
          "role": "power",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            2000
          ],
          "weight": 0.6,
          "note": "Radial pumps: shut-off power typically 30–60 % of BEP power"
        },
        {
          "role": "casing_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            30000,
            600000
          ],
          "weight": 0.8
        },
        {
          "role": "vibration",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            30000
          ],
          "weight": 0.4,
          "note": "Recirculation and radial thrust at zero flow"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "block",
            "label": "Discharge blocked",
            "kind": "cause"
          },
          {
            "id": "q",
            "label": "Flow → 0",
            "kind": "symptom",
            "role": "flow"
          },
          {
            "id": "pd",
            "label": "Discharge pressure → shut-off",
            "kind": "symptom",
            "role": "discharge_pressure"
          },
          {
            "id": "heat",
            "label": "Power dissipated into trapped liquid",
            "kind": "state"
          },
          {
            "id": "t",
            "label": "Liquid temperature ↑",
            "kind": "symptom",
            "role": "casing_temperature"
          },
          {
            "id": "pv",
            "label": "Vapour pressure ↑",
            "kind": "state"
          },
          {
            "id": "flash",
            "label": "Flashing / vapour lock",
            "kind": "consequence"
          }
        ],
        "edges": [
          {
            "from": "block",
            "to": "q",
            "sign": "-"
          },
          {
            "from": "block",
            "to": "pd",
            "sign": "+"
          },
          {
            "from": "q",
            "to": "heat",
            "sign": "-"
          },
          {
            "from": "heat",
            "to": "t",
            "sign": "+",
            "lag_ms": [
              30000,
              600000
            ],
            "loop_id": "thermal_flash"
          },
          {
            "from": "t",
            "to": "pv",
            "sign": "+",
            "loop_id": "thermal_flash"
          },
          {
            "from": "pv",
            "to": "flash",
            "sign": "+",
            "loop_id": "thermal_flash"
          },
          {
            "from": "flash",
            "to": "heat",
            "sign": "+",
            "loop_id": "thermal_flash"
          }
        ],
        "loops": [
          {
            "loop_id": "thermal_flash",
            "polarity": "reinforcing",
            "description": "Vapour reduces the liquid mass that absorbs the heat, so the remaining liquid heats faster."
          }
        ]
      },
      "propagation": [
        {
          "relation": "driver",
          "effect_role": "current",
          "direction": "fall",
          "polarity": "+",
          "lag_ms": [
            0,
            2000
          ],
          "edge_type": "structural_load_effect",
          "note": "Radial-flow pumps unload at shut-off; mixed/axial-flow pumps may draw more power instead"
        },
        {
          "relation": "process_downstream",
          "effect_role": "flow",
          "direction": "fall",
          "polarity": "+",
          "lag_ms": [
            0,
            2000
          ],
          "edge_type": "cause_to_effect"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "pump.dry_run_loss_of_prime",
          "rule": "Dead-head: discharge pressure rises. Dry run: discharge pressure collapses."
        },
        {
          "vs_pattern": "pump.driven_load_jam_overload",
          "rule": "A jam raises power; dead-head lowers power on radial pumps."
        }
      ],
      "signatures": [
        {
          "domain": "trend",
          "description": "Temperature rise rate of trapped liquid",
          "formula": "dT/dt ≈ P_shutoff / (m_liquid · c_p)"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Check discharge valve line-up and the check valve; confirm the downstream consumer is open.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check the minimum-flow bypass (recirculation) line is open and not blocked.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Compare discharge pressure with the published shut-off head.",
          "requires_isolation": false
        },
        {
          "order": 4,
          "text": "Allow the casing to cool and vent before opening; the liquid may be hot and pressurised.",
          "requires_isolation": true
        }
      ],
      "references": [
        "API 610 (minimum continuous stable flow)",
        "ANSI/HI 9.6.3 (allowable operating region)"
      ]
    },
    {
      "pattern_id": "pump.impeller_wear_recirculation",
      "version": "1.0.0",
      "failure_mode": "impeller_wear_recirculation",
      "title": "Impeller / wear-ring wear and internal recirculation",
      "category": "mechanical",
      "severity": "warning",
      "description": "Erosion, corrosion or wear-ring clearance growth lets liquid recirculate from discharge to suction inside the pump. Head and flow fall at the same speed while absorbed power stays about the same, so efficiency falls. Running well below BEP adds suction/discharge recirculation with low-frequency pulsation.",
      "typical_progression": "Months. Worn clearances of about twice design typically cost several points of efficiency.",
      "required_roles": [
        "differential_pressure"
      ],
      "optional_roles": [
        "flow",
        "power",
        "vibration",
        "vibration_vpf",
        "discharge_pressure"
      ],
      "trigger_role": "differential_pressure",
      "symptoms": [
        {
          "role": "differential_pressure",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "threshold_hint": {
            "relative_to_nominal": 0.95
          },
          "note": "Measured head below the pump curve at the same flow and speed"
        },
        {
          "role": "flow",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            2592000000
          ],
          "weight": 0.7
        },
        {
          "role": "power",
          "direction": "stuck",
          "onset_lag_ms": [
            0,
            2592000000
          ],
          "weight": 0.4,
          "note": "Power unchanged while hydraulic output falls, so efficiency falls"
        },
        {
          "role": "vibration",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            7776000000
          ],
          "weight": 0.3,
          "note": "Low-frequency random vibration from recirculation below BEP"
        },
        {
          "role": "vibration_vpf",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            7776000000
          ],
          "weight": 0.3,
          "note": "Vane pass rises when vane tips or the cutwater erode (gap B changes)"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "clr",
            "label": "Wear-ring clearance ↑",
            "kind": "cause"
          },
          {
            "id": "leak",
            "label": "Internal recirculation ↑",
            "kind": "state"
          },
          {
            "id": "h",
            "label": "Head ↓",
            "kind": "symptom",
            "role": "differential_pressure"
          },
          {
            "id": "eta",
            "label": "Efficiency ↓",
            "kind": "state"
          },
          {
            "id": "vel",
            "label": "Local velocity in gap ↑",
            "kind": "state"
          }
        ],
        "edges": [
          {
            "from": "clr",
            "to": "leak",
            "sign": "+"
          },
          {
            "from": "leak",
            "to": "h",
            "sign": "-"
          },
          {
            "from": "leak",
            "to": "eta",
            "sign": "-"
          },
          {
            "from": "leak",
            "to": "vel",
            "sign": "+"
          },
          {
            "from": "vel",
            "to": "clr",
            "sign": "+",
            "lag_ms": [
              2592000000,
              31536000000
            ],
            "loop_id": "wear_growth"
          }
        ],
        "loops": [
          {
            "loop_id": "wear_growth",
            "polarity": "reinforcing",
            "description": "Higher leakage velocity through the gap erodes the rings faster, especially with abrasive solids."
          }
        ]
      },
      "discriminators": [
        {
          "vs_pattern": "pump.cavitation_npsh",
          "rule": "Wear lowers head gradually at unchanged suction pressure and without HF broadband energy."
        },
        {
          "vs_pattern": "pump.suction_strainer_blockage",
          "rule": "Strainer blockage reduces flow with rising strainer ΔP; wear reduces head at the same flow with clean strainer ΔP."
        }
      ],
      "signatures": [
        {
          "domain": "trend",
          "description": "Hydraulic efficiency trend at constant speed",
          "formula": "η = ρ·g·Q·H / P_shaft"
        },
        {
          "domain": "trend",
          "description": "Affinity laws to correct test points to rated speed",
          "formula": "Q ∝ n, H ∝ n², P ∝ n³"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Take a head-flow-power test point, correct to rated speed with the affinity laws, and compare with the factory curve.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check the operating flow against the preferred operating region (70–120 % BEP per API 610).",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "At the next overhaul measure wear-ring clearances against the manufacturer limits.",
          "requires_isolation": true
        }
      ],
      "references": [
        "API 610 (preferred operating region)",
        "ANSI/HI 9.6.3",
        "ISO 9906 (pump acceptance tests)"
      ]
