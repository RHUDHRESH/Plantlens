      ],
      "discriminators": [
        {
          "vs_pattern": "fan.impeller_buildup_unbalance",
          "rule": "Unbalance is a steady 1× component; stall is sub-synchronous and tied to the operating point."
        },
        {
          "vs_pattern": "compressor.surge",
          "rule": "Same physics in compressors; this pattern applies to fans with pressure rise below ~30 kPa."
        }
      ],
      "signatures": [
