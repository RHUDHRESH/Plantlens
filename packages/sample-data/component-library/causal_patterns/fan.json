            2000
          ],
          "edge_type": "cause_to_effect",
          "note": "Parallel fans swap load; the stronger fan takes the flow"
        },
        {
          "relation": "driver",
          "effect_role": "current",
          "direction": "oscillate",
          "polarity": "any",
          "lag_ms": [
