          },
          {
            "id": "dp",
            "label": "Pressure rise ↓ and pulsating",
            "kind": "symptom",
            "role": "differential_pressure"
          },
          {
            "id": "rev",
            "label": "Momentary flow reversal",
            "kind": "state"
          },
          {
            "id": "q",
            "label": "Flow ↓",
            "kind": "symptom",
            "role": "flow"
          }
