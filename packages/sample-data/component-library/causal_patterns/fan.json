          "weight": 1.0,
          "note": "Pressure rise drops and pulsates"
        },
        {
          "role": "vibration_subsync",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            1000
          ],
          "weight": 0.9
        },
        {
          "role": "flow",
          "direction": "oscillate",
          "onset_lag_ms": [
            0,
            2000
          ],
