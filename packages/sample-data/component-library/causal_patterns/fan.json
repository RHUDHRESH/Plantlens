          },
          {
            "from": "rev",
            "to": "q",
            "sign": "-",
            "loop_id": "surge_cycle"
          },
          {
            "from": "q",
            "to": "aoa",
            "sign": "-",
            "loop_id": "surge_cycle"
          }
        ],
        "loops": [
          {
            "loop_id": "surge_cycle",
            "polarity": "reinforcing",
            "description": "Lower flow raises blade incidence, deepening stall and lowering pressure rise, which lets the system push flow back through the fan."
          }
        ]
      },
      "propagation": [
        {
          "relation": "parallel_unit",
          "effect_role": "flow",
          "direction": "oscillate",
          "polarity": "any",
          "lag_ms": [
