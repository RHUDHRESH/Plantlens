            "from": "q",
            "to": "aoa",
            "sign": "-"
          },
          {
            "from": "aoa",
            "to": "sep",
            "sign": "+"
          },
          {
            "from": "sep",
            "to": "dp",
            "sign": "-"
          },
          {
            "from": "dp",
