          "text": "Check for closed or blocked downstream dampers raising system resistance.",
          "requires_isolation": false
        },
        {
          "order": 4,
          "text": "After sustained stall, inspect blades and hub for cracks.",
          "requires_isolation": true
        }
      ],
      "references": [
        "AMCA 201 (fans and systems)",
        "ISO 5801 (fan performance testing)"
      ]
    },
