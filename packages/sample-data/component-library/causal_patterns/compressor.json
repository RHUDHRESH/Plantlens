  "patterns": [
    {
      "pattern_id": "compressor.surge",
      "version": "1.0.0",
      "failure_mode": "surge",
      "title": "Surge (centrifugal / axial compressor)",
      "category": "process",
      "severity": "critical",
      "description": "Flow falls below the surge limit at the prevailing pressure ratio. The compressor cannot sustain head, flow reverses through the machine, discharge pressure drops, forward flow resumes and the cycle repeats. Each cycle heats the gas, loads thrust bearings and seals, and can damage the rotor.",
      "typical_progression": "Cycle period typically 0.5–3 s for plant compressors; damage within a few cycles on large machines.",
      "required_roles": [
        "flow",
        "discharge_pressure"
      ],
      "optional_roles": [
        "discharge_temperature",
        "vibration",
        "power",
        "antisurge_valve_position",
        "suction_pressure"
      ],
      "trigger_role": "flow",
      "symptoms": [
        {
          "role": "flow",
          "direction": "oscillate",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "Rapid flow collapse and recovery; flow may read negative momentarily"
        },
        {
          "role": "discharge_pressure",
          "direction": "oscillate",
          "onset_lag_ms": [
            0,
            1000
          ],
          "weight": 0.9
        },
        {
          "role": "discharge_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            10000
          ],
          "weight": 0.7,
          "note": "Recirculated hot gas is recompressed"
        },
        {
          "role": "vibration",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            1000
          ],
          "weight": 0.6,
          "note": "Axial and sub-synchronous components"
        },
        {
          "role": "power",
          "direction": "oscillate",
          "onset_lag_ms": [
            0,
            1000
          ],
          "weight": 0.5
        },
        {
          "role": "antisurge_valve_position",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            2000
          ],
          "weight": 0.5,
          "note": "Anti-surge controller opens the recycle valve"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "low",
            "label": "Flow below surge limit",
            "kind": "cause",
            "role": "flow"
          },
          {
            "id": "head",
            "label": "Developed head < system pressure",
            "kind": "state"
          },
          {
            "id": "rev",
            "label": "Flow reversal",
            "kind": "state"
          },
          {
            "id": "pd",
            "label": "Discharge pressure ↓",
            "kind": "symptom",
            "role": "discharge_pressure"
          },
          {
            "id": "fwd",
            "label": "Forward flow resumes",
            "kind": "state"
          },
          {
            "id": "hot",
            "label": "Gas temperature ↑",
            "kind": "symptom",
            "role": "discharge_temperature"
          },
          {
            "id": "asv",
            "label": "Anti-surge valve opens",
            "kind": "state",
            "role": "antisurge_valve_position"
          }
        ],
        "edges": [
          {
            "from": "low",
            "to": "head",
            "sign": "-"
          },
          {
            "from": "head",
            "to": "rev",
            "sign": "-",
            "loop_id": "surge_cycle"
          },
          {
            "from": "rev",
            "to": "pd",
            "sign": "-",
            "loop_id": "surge_cycle"
          },
          {
            "from": "pd",
            "to": "fwd",
            "sign": "-",
            "loop_id": "surge_cycle"
          },
          {
            "from": "fwd",
            "to": "low",
            "sign": "-",
            "loop_id": "surge_cycle"
          },
          {
            "from": "rev",
            "to": "hot",
            "sign": "+"
          },
          {
            "from": "low",
            "to": "asv",
            "sign": "-",
            "lag_ms": [
              0,
              2000
            ],
            "loop_id": "antisurge"
          },
          {
            "from": "asv",
            "to": "low",
            "sign": "-",
            "loop_id": "antisurge"
          }
        ],
        "loops": [
          {
            "loop_id": "surge_cycle",
            "polarity": "reinforcing",
            "description": "On the positive-slope side of the characteristic, lower flow lowers head, which lets the system pressure push flow back: the cycle sustains itself."
          },
          {
            "loop_id": "antisurge",
            "polarity": "balancing",
            "description": "The anti-surge controller opens the recycle valve to restore flow through the machine."
          }
        ]
      },
      "propagation": [
        {
          "relation": "process_upstream",
          "effect_role": "pressure",
          "direction": "oscillate",
          "polarity": "any",
          "lag_ms": [
            0,
            1000
          ],
          "edge_type": "cause_to_effect"
        },
        {
          "relation": "process_downstream",
          "effect_role": "pressure",
          "direction": "oscillate",
          "polarity": "any",
          "lag_ms": [
            0,
            1000
          ],
          "edge_type": "cause_to_effect"
        },
        {
          "relation": "driver",
          "effect_role": "current",
          "direction": "oscillate",
          "polarity": "any",
          "lag_ms": [
            0,
            1000
          ],
          "edge_type": "structural_load_effect"
        },
        {
          "relation": "controller",
          "effect_role": "controller_output",
          "direction": "rise",
          "polarity": "any",
          "lag_ms": [
            0,
            2000
          ],
          "edge_type": "control",
          "note": "Anti-surge controller output increases"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "compressor.capacity_loss_inlet_filter",
          "rule": "Inlet restriction reduces flow smoothly with rising filter ΔP and can move the machine toward surge; surge itself is a fast oscillation."
        },
        {
          "vs_pattern": "fan.axial_stall_surge",
          "rule": "Same physics at low pressure rise; use the fan pattern for fans and blowers."
        }
      ],
      "signatures": [
        {
          "domain": "waveform",
          "description": "Large-amplitude, low-frequency flow and pressure oscillation; flow trace shows sharp drops to zero or negative."
        },
        {
          "domain": "trend",
          "description": "Surge margin on the compressor map",
          "formula": "SM = (Q_op − Q_surge) / Q_op at the operating pressure ratio"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Plot the operating point on the compressor map against the surge control line; record surge counter events.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check anti-surge valve stroke time and positioner response; check flow transmitter for plugged impulse lines.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Check for changes in gas molecular weight, suction temperature or downstream demand that shifted the operating point.",
          "requires_isolation": false
        },
        {
          "order": 4,
          "text": "After a surge event, review thrust bearing temperature and axial position trends.",
          "requires_isolation": false
        }
      ],
      "references": [
        "API 617 (axial and centrifugal compressors)",
        "API 670 (machinery protection)"
      ]
    },
    {
      "pattern_id": "compressor.discharge_valve_leak",
      "version": "1.0.0",
      "failure_mode": "discharge_valve_leak",
      "title": "Discharge valve leak (reciprocating compressor)",
      "category": "mechanical",
      "severity": "warning",
      "description": "A broken plate, worn seat or debris lets hot discharge gas leak back into the cylinder on the suction stroke. The gas is recompressed, so that valve cover and the stage discharge temperature rise while capacity falls.",
      "typical_progression": "Days to weeks from first leak to broken valve components.",
      "required_roles": [
        "valve_cover_temperature"
      ],
      "optional_roles": [
        "discharge_temperature",
        "flow",
        "interstage_pressure",
        "power"
      ],
      "trigger_role": "valve_cover_temperature",
      "symptoms": [
        {
          "role": "valve_cover_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "Rise of more than ~10–15 °C versus other discharge valves on the same stage"
        },
        {
          "role": "discharge_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            3600000
          ],
          "weight": 0.8
        },
        {
          "role": "flow",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            3600000
          ],
          "weight": 0.6
        },
        {
          "role": "interstage_pressure",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            3600000
          ],
          "weight": 0.5,
          "note": "First-stage discharge valve leak lowers interstage pressure; a later-stage leak raises it"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "leak",
            "label": "Discharge valve leaking",
            "kind": "cause"
          },
          {
            "id": "back",
            "label": "Hot gas flows back into cylinder",
            "kind": "state"
          },
          {
            "id": "recomp",
            "label": "Gas recompressed",
            "kind": "state"
          },
          {
            "id": "tv",
            "label": "Valve cover temperature ↑",
            "kind": "symptom",
            "role": "valve_cover_temperature"
          },
          {
            "id": "td",
            "label": "Discharge temperature ↑",
            "kind": "symptom",
            "role": "discharge_temperature"
          },
          {
            "id": "cap",
            "label": "Stage capacity ↓",
            "kind": "symptom",
            "role": "flow"
          },
          {
            "id": "damage",
            "label": "Valve plate heat and wear",
            "kind": "state"
          }
        ],
        "edges": [
          {
            "from": "leak",
            "to": "back",
            "sign": "+"
          },
          {
            "from": "back",
            "to": "recomp",
            "sign": "+"
          },
          {
            "from": "recomp",
            "to": "tv",
            "sign": "+"
          },
          {
            "from": "recomp",
            "to": "td",
            "sign": "+"
          },
          {
            "from": "back",
            "to": "cap",
            "sign": "-"
          },
          {
            "from": "tv",
            "to": "damage",
            "sign": "+",
            "lag_ms": [
              86400000,
              1209600000
            ],
            "loop_id": "valve_degradation"
          },
          {
            "from": "damage",
            "to": "leak",
            "sign": "+",
            "loop_id": "valve_degradation"
          }
        ],
        "loops": [
          {
            "loop_id": "valve_degradation",
            "polarity": "reinforcing",
            "description": "Leaking gas heats and erodes the valve components, which increases the leak."
          }
        ]
      },
      "discriminators": [
        {
          "vs_pattern": "compressor.high_discharge_temperature",
          "rule": "A valve leak heats one valve cover more than the others on the stage; a process cause heats all valves and the whole stage."
        },
        {
          "vs_pattern": "compressor.intercooler_fouling",
          "rule": "Intercooler fouling raises next-stage inlet temperature first; a valve leak raises one valve cover first.",
          "first_role": "valve_cover_temperature",
          "then_role": "interstage_temperature"
        }
      ],
      "signatures": [
        {
          "domain": "thermal",
          "description": "Per-valve cover temperature compared with siblings on the same cylinder end"
        },
        {
          "domain": "waveform",
          "description": "PV diagram: discharge valve leak steepens the re-expansion line and shifts suction valve opening later"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Compare valve cover temperatures across all valves of the stage.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Run a PV / ultrasonic valve analysis if an analyser is installed.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Remove and inspect the suspect valve with the cylinder isolated, depressurised and purged.",
          "requires_isolation": true
        }
      ],
      "references": [
        "API 618 (reciprocating compressors)",
        "API 670"
      ]
    },
    {
      "pattern_id": "compressor.high_discharge_temperature",
      "version": "1.0.0",
      "failure_mode": "high_discharge_temperature",
      "title": "High discharge temperature",
      "category": "thermal",
      "severity": "warning",
      "description": "Discharge temperature rises above the design value from a higher pressure ratio, hotter suction gas, reduced oil-injection cooling (screw compressors), or internal recirculation. High temperature degrades lubricant, carbonises valves and can ignite oil deposits.",
      "typical_progression": "Minutes to hours.",
      "required_roles": [
        "discharge_temperature"
      ],
      "optional_roles": [
        "suction_temperature",
        "suction_pressure",
        "discharge_pressure",
        "oil_temperature",
        "power"
      ],
      "trigger_role": "discharge_temperature",
      "symptoms": [
        {
          "role": "discharge_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "threshold_hint": {
            "absolute": 150
          },
          "note": "API 618 limits predicted discharge temperature to 150 °C; oil-flooded screws often trip near 110 °C"
        },
        {
          "role": "suction_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.4,
          "note": "When the cause is hot suction gas"
        },
        {
          "role": "discharge_pressure",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.4,
          "note": "When the cause is a higher pressure ratio"
        },
        {
          "role": "oil_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            1800000
          ],
          "weight": 0.5,
          "note": "Oil-injected machines: oil cooler or thermostatic valve fault"
        },
        {
          "role": "power",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            1800000
          ],
          "weight": 0.3
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "ratio",
            "label": "Pressure ratio ↑ / suction temperature ↑",
            "kind": "cause"
          },
          {
            "id": "t2",
            "label": "Discharge temperature ↑",
            "kind": "symptom",
            "role": "discharge_temperature"
          },
          {
            "id": "visc",
            "label": "Oil viscosity ↓",
            "kind": "state"
          },
          {
            "id": "seal",
            "label": "Internal sealing ↓ (screw)",
            "kind": "state"
          },
          {
            "id": "recirc",
            "label": "Internal leakage ↑",
            "kind": "state"
          }
        ],
        "edges": [
          {
            "from": "ratio",
            "to": "t2",
            "sign": "+"
          },
          {
            "from": "t2",
            "to": "visc",
            "sign": "-",
            "loop_id": "oil_seal"
          },
          {
            "from": "visc",
            "to": "seal",
            "sign": "+",
            "loop_id": "oil_seal"
          },
          {
            "from": "seal",
            "to": "recirc",
            "sign": "-",
            "loop_id": "oil_seal"
          },
          {
            "from": "recirc",
            "to": "t2",
            "sign": "+",
            "loop_id": "oil_seal"
          }
        ],
        "loops": [
          {
            "loop_id": "oil_seal",
            "polarity": "reinforcing",
            "description": "In oil-injected screw compressors hotter oil seals the rotors less well; more gas leaks back and is recompressed, raising temperature further."
          }
        ]
      },
      "propagation": [
        {
          "relation": "process_downstream",
          "effect_role": "temperature",
          "direction": "rise",
          "polarity": "+",
          "lag_ms": [
            0,
            300000
          ],
          "edge_type": "thermal"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "compressor.discharge_valve_leak",
          "rule": "A single hot valve cover points to a valve leak; a uniform stage-wide rise points to process or cooling causes."
        },
        {
          "vs_pattern": "compressor.intercooler_fouling",
          "rule": "If next-stage inlet temperature rose first, the intercooler is the cause.",
          "first_role": "interstage_temperature",
          "then_role": "discharge_temperature"
        }
      ],
      "signatures": [
        {
          "domain": "trend",
          "description": "Expected discharge temperature for comparison",
          "formula": "T2 = T1 · (P2/P1)^((k−1)/(k·ηp))  (absolute temperatures)"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Compute expected discharge temperature from measured suction temperature and pressure ratio; a large excess points to internal leakage or valve faults.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check oil injection temperature, oil cooler and thermostatic valve on oil-flooded machines.",
          "requires_isolation": false
        },
