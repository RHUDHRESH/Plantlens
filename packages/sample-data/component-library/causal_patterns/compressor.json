          },
          {
            "from": "tw",
            "to": "scale",
            "sign": "+",
            "lag_ms": [
              604800000,
              15552000000
            ],
            "loop_id": "scale_growth"
          }
        ],
        "loops": [
          {
            "loop_id": "scale_growth",
            "polarity": "reinforcing",
            "description": "Hardness salts (CaCO3) have inverse solubility; a hotter wall scales faster, further reducing heat transfer."
          }
        ]
      },
      "propagation": [
        {
          "relation": "cooling_system",
          "effect_role": "temperature",
