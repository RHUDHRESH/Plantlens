    {
      "pattern_id": "transformer.harmonic_heating_k_factor",
      "version": "1.0.0",
      "failure_mode": "harmonic_heating_k_factor",
      "title": "Harmonic heating (K-factor)",
      "category": "thermal",
      "severity": "warning",
      "description": "Non-linear loads (drives, rectifiers, LED and IT loads) inject harmonic currents. Eddy-current and stray losses grow with h², so the windings and structural parts heat above what the RMS current suggests; triplen harmonics also add up in the neutral.",
      "typical_progression": "Continuous; heating follows the load mix.",
      "required_roles": [
        "thd_current"
      ],
      "optional_roles": [
        "k_factor",
        "hot_spot_temperature",
        "top_oil_temperature",
        "neutral_current",
        "current"
      ],
      "trigger_role": "thd_current",
      "symptoms": [
        {
          "role": "thd_current",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "threshold_hint": {
            "absolute": 15
          },
          "note": "Check against IEEE 519 current distortion limits at the PCC"
        },
        {
          "role": "k_factor",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.8,
          "threshold_hint": {
            "absolute": 4
          },
          "note": "Above the transformer's K rating (standard units K-1)"
        },
        {
          "role": "hot_spot_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            600000,
            7200000
          ],
          "weight": 0.7,
          "note": "Temperature high relative to RMS load"
        },
        {
          "role": "neutral_current",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.5,
          "note": "Triplen harmonics sum in the neutral"
        }
      ],
      "propagation": [
        {
          "relation": "upstream_supply",
          "effect_role": "voltage_thd",
          "direction": "rise",
          "polarity": "+",
          "lag_ms": [
            0,
            1000
          ],
          "edge_type": "structural_power",
          "note": "Harmonic currents through source impedance distort the voltage"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "transformer.overload",
          "rule": "Harmonic heating raises temperature at normal RMS current with high THD."
        },
        {
          "vs_pattern": "transformer.hotspot_cooling_failure",
          "rule": "Cooling failure has normal THD and a cooling status change."
        }
      ],
      "signatures": [
        {
          "domain": "current_spectrum",
          "description": "K-factor from the load current spectrum",
          "formula": "K = Σ (I_h/I_rms)² · h²"
        },
        {
          "domain": "current_spectrum",
          "description": "Harmonic loss factor for winding eddy losses (IEEE C57.110)",
          "formula": "F_HL = Σ (I_h/I_1)² h² / Σ (I_h/I_1)²"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Measure the current harmonic spectrum at the LV terminals under typical load.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Derate per IEEE C57.110 or compare with the transformer K rating.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Check neutral conductor sizing and temperature for triplen currents.",
          "requires_isolation": false
        }
      ],
      "references": [
        "IEEE C57.110 (transformer capability with non-sinusoidal load)",
        "IEEE 519 (harmonic control)",
        "UL 1561 (K-factor rating)"
      ]
    },
