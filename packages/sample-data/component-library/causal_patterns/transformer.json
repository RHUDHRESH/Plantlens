          "edge_type": "structural_power",
          "note": "Or rise, following the regulation error"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "transformer.overload",
          "rule": "Load-driven voltage drop is within the regulation capability with taps moving; a tap changer fault shows voltage out of band with taps stuck."
        },
        {
          "vs_pattern": "transformer.insulation_dga_gassing",
          "rule": "Acetylene is normal in the OLTC compartment; it is abnormal in the main tank."
