            "kind": "state"
          },
          {
            "id": "tap",
            "label": "Tap position changes",
            "kind": "symptom",
            "role": "tap_position"
          },
          {
            "id": "stuck",
            "label": "Drive mechanism fault",
            "kind": "cause"
          }
        ],
        "edges": [
          {
            "from": "v",
            "to": "avr",
            "sign": "+",
