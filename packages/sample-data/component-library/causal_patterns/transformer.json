      "category": "mechanical",
      "severity": "warning",
      "description": "The OLTC drive mechanism fails to move (motor, brake, limit switch, control), hunts between taps (AVR bandwidth narrower than the tap step), or its contacts coke and overheat. Secondary voltage leaves the regulation band or the OLTC compartment runs hot.",
      "typical_progression": "Sudden for drive failures; months for contact coking.",
      "required_roles": [
        "tap_position"
      ],
      "optional_roles": [
        "voltage",
        "oltc_temperature_diff",
        "oltc_motor_current"
      ],
      "trigger_role": "tap_position",
      "symptoms": [
        {
          "role": "tap_position",
          "direction": "stuck",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "No tap change while voltage is outside the AVR band beyond its time delay; or rapid alternation (hunting)"
        },
        {
          "role": "voltage",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            300000
          ],
          "weight": 0.8,
          "note": "Or rise: outside the regulation band"
        },
        {
          "role": "oltc_temperature_diff",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            2592000000
          ],
          "weight": 0.5,
          "note": "OLTC compartment warmer than main tank points to contact overheating"
        },
        {
          "role": "oltc_motor_current",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.4,
          "note": "Higher or longer motor current indicates mechanical drag"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "v",
            "label": "Secondary voltage deviation",
            "kind": "symptom",
            "role": "voltage"
          },
          {
            "id": "avr",
