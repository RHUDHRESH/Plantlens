  "patterns": [
    {
      "pattern_id": "transformer.overload",
      "version": "1.0.0",
      "failure_mode": "overload",
      "title": "Overload (loading beyond nameplate)",
      "category": "thermal",
      "severity": "warning",
      "description": "Load current above rating raises load losses (∝ I²). Top oil follows with a time constant of hours, the winding hot spot with minutes. Insulation ageing rate grows exponentially with hot-spot temperature.",
      "typical_progression": "Minutes for hot-spot gradient; 1.5–3 h (ONAN) oil time constant; ageing accrues over the overload duration.",
      "required_roles": [
        "current"
      ],
      "optional_roles": [
        "hot_spot_temperature",
        "top_oil_temperature",
        "voltage",
        "cooling_status"
      ],
      "trigger_role": "current",
      "symptoms": [
        {
          "role": "current",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "threshold_hint": {
            "relative_to_nominal": 1.0,
            "for_ms": 600000
          },
          "note": "Above nameplate rating at the current cooling stage"
        },
        {
          "role": "hot_spot_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            60000,
            1800000
          ],
          "weight": 0.8,
          "threshold_hint": {
            "absolute": 110
          },
          "note": "IEEE C57.91: 110 °C continuous for thermally upgraded paper; IEC 60076-7: 98 °C reference for normal paper"
        },
        {
          "role": "top_oil_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            1800000,
            21600000
          ],
          "weight": 0.7
        },
        {
          "role": "cooling_status",
          "direction": "step",
          "onset_lag_ms": [
            300000,
            3600000
          ],
          "weight": 0.4,
          "note": "Fan stages start"
        },
        {
          "role": "voltage",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            1000
          ],
          "weight": 0.3,
          "note": "Regulation drop at high load"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "load",
            "label": "Load current ↑",
            "kind": "cause",
            "role": "current"
          },
          {
            "id": "loss",
            "label": "Load losses ∝ I²",
            "kind": "state"
          },
          {
            "id": "hs",
            "label": "Hot-spot temperature ↑",
            "kind": "symptom",
            "role": "hot_spot_temperature"
          },
          {
            "id": "to",
            "label": "Top-oil temperature ↑",
            "kind": "symptom",
            "role": "top_oil_temperature"
          },
          {
            "id": "fan",
            "label": "Cooling stages start",
            "kind": "state",
            "role": "cooling_status"
          },
          {
            "id": "age",
            "label": "Insulation ageing rate ↑",
            "kind": "consequence"
          }
        ],
        "edges": [
          {
            "from": "load",
            "to": "loss",
            "sign": "+"
          },
          {
            "from": "loss",
            "to": "hs",
            "sign": "+",
            "lag_ms": [
              60000,
              1800000
            ]
          },
          {
            "from": "loss",
            "to": "to",
            "sign": "+",
            "lag_ms": [
              1800000,
              21600000
            ]
          },
          {
            "from": "to",
            "to": "fan",
            "sign": "+",
            "loop_id": "forced_cooling"
          },
          {
            "from": "fan",
            "to": "to",
            "sign": "-",
            "loop_id": "forced_cooling"
          },
          {
            "from": "hs",
            "to": "age",
            "sign": "+"
          }
        ],
        "loops": [
          {
            "loop_id": "forced_cooling",
            "polarity": "balancing",
            "description": "Rising oil temperature switches on fans and pumps, which lower the oil temperature rise."
          }
        ]
      },
      "propagation": [
        {
          "relation": "upstream_supply",
          "effect_role": "current",
          "direction": "rise",
          "polarity": "+",
          "lag_ms": [
            0,
            100
          ],
          "edge_type": "structural_load_effect"
        },
        {
          "relation": "downstream_load",
          "effect_role": "voltage",
          "direction": "fall",
          "polarity": "-",
          "lag_ms": [
            0,
            1000
          ],
          "edge_type": "structural_power"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "transformer.hotspot_cooling_failure",
          "rule": "Overload: current rises first. Cooling failure: temperature rises at normal current, usually after cooling status changes.",
          "first_role": "current",
          "then_role": "top_oil_temperature"
        },
        {
          "vs_pattern": "transformer.harmonic_heating_k_factor",
          "rule": "Harmonic heating raises temperature at normal RMS current with high THD."
        }
      ],
      "signatures": [
        {
          "domain": "trend",
          "description": "Relative ageing rate (IEC 60076-7, non-upgraded paper)",
          "formula": "V = 2^((θh − 98)/6)"
        },
        {
          "domain": "trend",
          "description": "Relative ageing rate (IEEE C57.91, upgraded paper)",
          "formula": "F_AA = exp(15000/383 − 15000/(θH + 273))"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Compare load with nameplate rating for the active cooling stage (ONAN / ONAF).",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Compute loss-of-life for the event with the IEC 60076-7 or IEEE C57.91 model.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Check whether load can be shared with a parallel transformer (operator decision).",
          "requires_isolation": false
        }
      ],
      "references": [
        "IEC 60076-7 (loading guide for oil-immersed transformers)",
        "IEEE C57.91 (loading guide)",
        "IEC 60076-2 (temperature rise)"
      ]
    },
    {
      "pattern_id": "transformer.hotspot_cooling_failure",
      "version": "1.0.0",
      "failure_mode": "hotspot_cooling_failure",
      "title": "Winding hot spot / cooling failure",
      "category": "thermal",
      "severity": "warning",
      "description": "Fans or oil pumps fail, radiator valves are closed, radiators are blocked, or oil level is low. Temperatures rise at normal load; the transformer effectively operates at its lower ONAN rating.",
      "typical_progression": "Tens of minutes to hours.",
      "required_roles": [
        "top_oil_temperature"
      ],
      "optional_roles": [
        "hot_spot_temperature",
        "cooling_status",
        "current",
        "ambient_temperature",
        "oil_level"
      ],
      "trigger_role": "top_oil_temperature",
      "symptoms": [
        {
          "role": "top_oil_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "Top oil above the expected value for load and ambient by > ~10 K"
        },
        {
          "role": "cooling_status",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.8,
          "note": "Fans / pumps off or tripped while commanded"
        },
        {
          "role": "hot_spot_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            1800000
          ],
          "weight": 0.9
        },
        {
          "role": "oil_level",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.3,
          "note": "When the cause is oil loss"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "cool",
            "label": "Cooling capacity ↓",
            "kind": "cause",
            "role": "cooling_status"
          },
          {
            "id": "to",
            "label": "Top-oil temperature ↑",
            "kind": "symptom",
            "role": "top_oil_temperature"
          },
          {
            "id": "hs",
            "label": "Hot spot ↑",
            "kind": "symptom",
            "role": "hot_spot_temperature"
          },
          {
            "id": "h2o",
            "label": "Moisture released from paper",
            "kind": "state"
          },
          {
            "id": "age",
            "label": "Paper depolymerisation ↑",
            "kind": "state"
          }
        ],
        "edges": [
          {
            "from": "cool",
            "to": "to",
            "sign": "-",
            "lag_ms": [
              1800000,
              14400000
            ]
          },
          {
            "from": "to",
            "to": "hs",
            "sign": "+"
          },
          {
            "from": "hs",
            "to": "age",
            "sign": "+",
            "loop_id": "moisture_ageing"
          },
          {
            "from": "age",
            "to": "h2o",
            "sign": "+",
            "loop_id": "moisture_ageing"
          },
          {
            "from": "h2o",
            "to": "age",
            "sign": "+",
            "lag_ms": [
              2592000000,
              31536000000
            ],
            "loop_id": "moisture_ageing"
          }
        ],
        "loops": [
          {
            "loop_id": "moisture_ageing",
            "polarity": "reinforcing",
            "description": "Hot paper degrades and releases water; wet paper ages several times faster."
          }
        ]
      },
      "propagation": [
        {
          "relation": "cooling_system",
          "effect_role": "temperature",
          "direction": "rise",
          "polarity": "+",
          "lag_ms": [
            0,
            1800000
          ],
          "edge_type": "thermal"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "transformer.overload",
          "rule": "Cooling failure: cooling status falls first and temperature rises at normal current.",
          "first_role": "cooling_status",
          "then_role": "top_oil_temperature"
        },
        {
          "vs_pattern": "transformer.harmonic_heating_k_factor",
          "rule": "Harmonic heating shows high current THD with cooling running normally."
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Check fan and pump contactors, supply MCBs and the cooling control (thermostat / WTI contacts).",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check radiator valves are open and radiators are not blocked.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Check conservator oil level and look for leaks.",
          "requires_isolation": false
        },
        {
          "order": 4,
          "text": "Compare top oil with the expected value from load and ambient (IEC 60076-7 thermal model).",
          "requires_isolation": false
        }
      ],
      "references": [
        "IEC 60076-7",
        "IEEE C57.91",
        "IEC 60076-2"
      ]
    },
    {
      "pattern_id": "transformer.insulation_dga_gassing",
      "version": "1.0.0",
      "failure_mode": "insulation_dga_gassing",
      "title": "Insulation degradation / abnormal DGA gassing",
      "category": "insulation",
      "severity": "critical",
      "description": "Oil and paper break down under partial discharge, arcing or local overheating and generate characteristic gases: H2 (PD), C2H2 (arcing), C2H4 (thermal > 300 °C), CO/CO2 (paper). Rising gas levels and generation rates indicate an active fault.",
      "typical_progression": "Weeks to months for thermal faults; hours for arcing faults (Buchholz may operate).",
      "required_roles": [
        "dga_h2"
      ],
      "optional_roles": [
        "dga_c2h2",
        "dga_c2h4",
        "dga_co",
        "dga_tdcg",
        "moisture_in_oil",
        "partial_discharge",
        "buchholz"
      ],
      "trigger_role": "dga_h2",
      "symptoms": [
        {
          "role": "dga_h2",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "Compare with IEEE C57.104-2019 90th/95th percentile levels and rates for the transformer's age and O2/N2 ratio"
        },
        {
          "role": "dga_c2h2",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            2592000000
          ],
          "weight": 0.8,
          "note": "Any sustained increase indicates arcing or high-energy discharge"
        },
        {
          "role": "dga_c2h4",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            2592000000
          ],
          "weight": 0.6,
          "note": "Thermal fault > 300 °C"
        },
        {
          "role": "dga_co",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            2592000000
          ],
          "weight": 0.5,
          "note": "Paper involvement; CO2/CO < 3 suggests severe paper degradation"
        },
        {
          "role": "partial_discharge",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.5
        },
        {
          "role": "buchholz",
          "direction": "trip",
          "onset_lag_ms": [
            0,
            2592000000
          ],
          "weight": 0.3,
          "note": "Gas accumulation alarm or surge trip"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "stress",
            "label": "Electrical / thermal stress",
            "kind": "cause"
          },
          {
            "id": "deg",
            "label": "Oil and paper decomposition",
            "kind": "state"
          },
          {
            "id": "gas",
            "label": "Fault gases in oil",
            "kind": "symptom",
            "role": "dga_h2"
          },
          {
            "id": "h2o",
            "label": "Water and acids formed",
            "kind": "state",
            "role": "moisture_in_oil"
          },
          {
            "id": "ins",
            "label": "Dielectric strength ↓",
            "kind": "state"
          },
          {
            "id": "pd",
            "label": "Partial discharge ↑",
            "kind": "symptom",
            "role": "partial_discharge"
          }
        ],
        "edges": [
          {
            "from": "stress",
            "to": "deg",
            "sign": "+"
          },
          {
            "from": "deg",
            "to": "gas",
            "sign": "+"
          },
          {
            "from": "deg",
            "to": "h2o",
            "sign": "+"
          },
          {
            "from": "h2o",
            "to": "ins",
            "sign": "-"
          },
          {
            "from": "ins",
            "to": "pd",
            "sign": "-",
