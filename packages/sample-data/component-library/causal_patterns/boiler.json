  "patterns": [
    {
      "pattern_id": "boiler.low_water_level",
      "version": "1.0.0",
      "failure_mode": "low_water_level",
      "title": "Low drum / shell water level",
      "category": "process",
      "severity": "critical",
      "description": "Water level falls because feedwater supply is short of steam demand (feed pump, feed valve or control fault), from a tube leak, or from shrink after a sudden load drop. Uncovered heating surfaces overheat within minutes; the low-water cut-off must trip the burner.",
      "typical_progression": "Seconds to minutes. Shrink and swell cause transient level moves opposite to the mass balance.",
      "required_roles": [
        "drum_level"
      ],
      "optional_roles": [
        "feedwater_flow",
        "steam_flow",
        "low_water_cutoff",
        "burner_trip",
        "steam_pressure"
      ],
      "trigger_role": "drum_level",
      "symptoms": [
        {
          "role": "drum_level",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "Below the low alarm set by the manufacturer relative to the lowest permissible water level"
        },
        {
          "role": "feedwater_flow",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.7,
          "note": "Feedwater below steam flow"
        },
        {
          "role": "low_water_cutoff",
          "direction": "trip",
          "onset_lag_ms": [
            0,
            300000
          ],
          "weight": 0.9
        },
        {
          "role": "burner_trip",
          "direction": "trip",
          "onset_lag_ms": [
            0,
            300000
          ],
          "weight": 0.8
        },
        {
          "role": "steam_pressure",
          "direction": "fall",
          "onset_lag_ms": [
            60000,
            600000
          ],
          "weight": 0.4,
          "note": "After the burner trips"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "imb",
            "label": "Feedwater < steam flow",
            "kind": "cause"
          },
          {
            "id": "l",
            "label": "Drum level ↓",
            "kind": "symptom",
            "role": "drum_level"
          },
          {
            "id": "lic",
            "label": "Level controller opens feed valve",
            "kind": "state"
          },
          {
            "id": "fw",
            "label": "Feedwater flow ↑",
            "kind": "state",
            "role": "feedwater_flow"
          },
          {
            "id": "cold",
            "label": "Cold feedwater collapses bubbles (shrink)",
            "kind": "state"
          }
        ],
        "edges": [
          {
            "from": "imb",
            "to": "l",
            "sign": "-"
          },
          {
            "from": "l",
            "to": "lic",
            "sign": "-",
            "loop_id": "level_control"
          },
          {
            "from": "lic",
            "to": "fw",
            "sign": "+",
            "loop_id": "level_control"
          },
          {
            "from": "fw",
            "to": "l",
            "sign": "+",
            "loop_id": "level_control"
          },
          {
            "from": "fw",
            "to": "cold",
            "sign": "+",
            "loop_id": "shrink"
          },
          {
            "from": "cold",
            "to": "l",
            "sign": "-",
            "lag_ms": [
              0,
              60000
            ],
            "loop_id": "shrink"
          }
        ],
        "loops": [
          {
            "loop_id": "level_control",
            "polarity": "balancing",
            "description": "The drum level controller raises feedwater to restore level."
          },
          {
            "loop_id": "shrink",
            "polarity": "reinforcing",
            "description": "Short term, more cold feedwater collapses steam bubbles and the level falls further before it rises (non-minimum-phase); single-element control can over-react. Three-element control uses steam flow feed-forward."
          }
        ]
      },
      "propagation": [
        {
          "relation": "process_downstream",
          "effect_role": "pressure",
          "direction": "fall",
          "polarity": "+",
          "lag_ms": [
            60000,
            600000
          ],
          "edge_type": "cause_to_effect",
          "note": "Steam header pressure falls after the burner trips"
        },
        {
          "relation": "process_upstream",
          "effect_role": "flow",
          "direction": "rise",
          "polarity": "-",
          "lag_ms": [
            0,
            60000
          ],
          "edge_type": "cause_to_effect",
          "note": "Feed pump flow rises as the feed valve opens"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "boiler.feedwater_pump_failure",
          "rule": "If feedwater pressure fell first, the feed pump is the origin.",
          "first_role": "feedwater_pressure",
          "then_role": "drum_level"
        },
        {
          "vs_pattern": "boiler.tube_leak",
          "rule": "A tube leak shows feedwater flow exceeding steam flow with level still hard to hold."
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Confirm the level on the direct-reading gauge glass and compare with the remote indicators.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Confirm the low-water cut-off and burner trip operated. Do not add feedwater to a boiler whose level has dropped out of sight; follow the site emergency procedure.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Check feed pump status, feed valve position and deaerator level.",
          "requires_isolation": false
        },
        {
          "order": 4,
          "text": "Test the low-water cut-off per the site schedule (blowdown test of float chambers).",
          "requires_isolation": false
        }
      ],
      "references": [
        "ASME BPVC Section I (PG-60 water level indicators)",
        "ASME CSD-1 (controls and safety devices)",
        "NFPA 85 (boiler and combustion systems hazards)"
      ]
    },
    {
      "pattern_id": "boiler.high_steam_pressure",
      "version": "1.0.0",
      "failure_mode": "high_steam_pressure",
      "title": "High steam pressure",
      "category": "process",
      "severity": "critical",
      "description": "Steam pressure rises because demand dropped faster than firing (load rejection) or because the pressure/firing control failed high. The pressure control and high-pressure limit should cut firing before the safety valves lift.",
      "typical_progression": "Seconds to minutes.",
      "required_roles": [
        "steam_pressure"
      ],
      "optional_roles": [
        "steam_flow",
        "fuel_flow",
        "safety_valve_lift",
        "burner_trip"
      ],
      "trigger_role": "steam_pressure",
      "symptoms": [
        {
          "role": "steam_pressure",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "Above the operating limit; safety valves set at or below MAWP (ASME Section I PG-67)"
        },
        {
          "role": "steam_flow",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.7,
          "note": "Load rejection: steam flow falls first"
        },
        {
          "role": "fuel_flow",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.5,
          "note": "Control failure: firing rises first"
        },
        {
          "role": "burner_trip",
          "direction": "trip",
          "onset_lag_ms": [
            0,
            120000
          ],
          "weight": 0.5,
          "note": "High-pressure limit"
        },
        {
          "role": "safety_valve_lift",
          "direction": "trip",
          "onset_lag_ms": [
            0,
            300000
          ],
          "weight": 0.6
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "dem",
            "label": "Steam demand ↓ or firing ↑",
            "kind": "cause"
          },
          {
            "id": "p",
            "label": "Steam pressure ↑",
            "kind": "symptom",
            "role": "steam_pressure"
          },
          {
            "id": "pic",
            "label": "Pressure controller cuts firing",
            "kind": "state"
          },
          {
            "id": "fire",
            "label": "Firing rate ↓",
            "kind": "state",
            "role": "fuel_flow"
          }
        ],
        "edges": [
          {
            "from": "dem",
            "to": "p",
            "sign": "+"
          },
          {
            "from": "p",
            "to": "pic",
            "sign": "+",
            "loop_id": "pressure_control"
          },
          {
            "from": "pic",
            "to": "fire",
            "sign": "-",
            "loop_id": "pressure_control"
          },
          {
            "from": "fire",
            "to": "p",
            "sign": "+",
            "lag_ms": [
              10000,
              300000
            ],
            "loop_id": "pressure_control"
          }
        ],
        "loops": [
          {
            "loop_id": "pressure_control",
            "polarity": "balancing",
            "description": "The master pressure controller reduces firing as pressure rises."
          }
        ]
      },
      "propagation": [
        {
          "relation": "process_downstream",
          "effect_role": "pressure",
          "direction": "rise",
          "polarity": "+",
          "lag_ms": [
            0,
            60000
          ],
          "edge_type": "cause_to_effect"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "boiler.low_water_level",
          "rule": "Level swell accompanies a pressure drop, not a rise; a sudden pressure rise causes shrink."
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Determine whether steam flow fell or fuel flow rose first.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check the pressure controller mode and output, and the fuel valve position.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Confirm high-pressure limit and safety valve test records are current.",
          "requires_isolation": false
        }
      ],
      "references": [
        "ASME BPVC Section I (PG-67 safety valves)",
        "ASME CSD-1",
        "NFPA 85"
      ]
    },
    {
      "pattern_id": "boiler.flame_failure",
      "version": "1.0.0",
      "failure_mode": "flame_failure",
      "title": "Flame failure",
      "category": "process",
      "severity": "critical",
      "description": "The flame is lost (fuel supply pressure low, air/fuel ratio off, water in oil, igniter or burner fault) or the scanner loses sight of it (dirty lens, cooling air loss, failing scanner). The burner management system must shut off fuel within the flame failure response time.",
      "typical_progression": "Seconds. NFPA 85 limits flame failure response time to 4 s maximum.",
      "required_roles": [
        "flame_signal"
      ],
      "optional_roles": [
        "burner_trip",
        "fuel_pressure",
        "fuel_flow",
        "o2",
        "co",
        "furnace_pressure",
        "steam_pressure"
      ],
      "trigger_role": "flame_signal",
      "symptoms": [
        {
          "role": "flame_signal",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "Below the scanner's flame-on threshold"
        },
        {
          "role": "burner_trip",
          "direction": "trip",
          "onset_lag_ms": [
            0,
            4000
          ],
          "weight": 0.9
        },
        {
          "role": "fuel_pressure",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.5,
          "note": "If the fuel supply is the cause"
        },
        {
          "role": "o2",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            10000
          ],
          "weight": 0.6
        },
        {
          "role": "co",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            10000
          ],
          "weight": 0.4,
          "note": "Unstable combustion before the loss"
        },
        {
          "role": "furnace_pressure",
          "direction": "oscillate",
          "onset_lag_ms": [
            0,
            5000
          ],
          "weight": 0.4
        },
        {
          "role": "steam_pressure",
          "direction": "fall",
          "onset_lag_ms": [
            30000,
            600000
          ],
          "weight": 0.5
        }
      ],
      "propagation": [
        {
          "relation": "process_downstream",
          "effect_role": "pressure",
          "direction": "fall",
          "polarity": "+",
          "lag_ms": [
            30000,
            600000
          ],
          "edge_type": "cause_to_effect",
          "note": "Steam supply lost"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "boiler.high_steam_pressure",
          "rule": "A high-pressure limit trip also shuts the burner, but pressure rises before the flame signal falls.",
          "first_role": "steam_pressure",
          "then_role": "flame_signal"
        }
      ],
      "signatures": [
        {
          "domain": "trend",
          "description": "Real flame loss shows O2 rising and furnace temperature falling; a scanner fault shows a falling flame signal with normal O2 and CO before the trip"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Review the BMS first-out indication.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check fuel supply pressure and filters, and oil temperature / atomising medium for oil burners.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Clean or check the scanner lens, sighting tube and cooling air with the burner shut down.",
          "requires_isolation": true
        },
        {
          "order": 4,
          "text": "Complete the pre-purge per the BMS before any relight; do not bypass the flame safeguard.",
          "requires_isolation": false
        }
      ],
      "references": [
        "NFPA 85 (boiler and combustion systems hazards)",
        "EN 298 (automatic burner control systems)",
        "ASME CSD-1"
      ]
    },
    {
      "pattern_id": "boiler.tube_leak",
      "version": "1.0.0",
      "failure_mode": "tube_leak",
      "title": "Boiler tube leak",
      "category": "mechanical",
      "severity": "critical",
      "description": "A water-wall, economiser or superheater tube leaks from corrosion, erosion, overheating or fatigue. Water is lost to the furnace or flue: feedwater exceeds steam flow, make-up rises, and the leak jet erodes adjacent tubes.",
      "typical_progression": "Days to weeks for a pinhole; a leak can escalate to a rupture within hours.",
      "required_roles": [
        "feedwater_flow",
        "steam_flow"
      ],
      "optional_roles": [
        "makeup_flow",
        "acoustic",
        "furnace_pressure",
        "drum_level",
        "flue_gas_temperature",
        "o2"
      ],
      "trigger_role": "feedwater_flow",
      "symptoms": [
        {
          "role": "feedwater_flow",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "Feedwater minus steam flow (net of blowdown) above its normal offset"
        },
        {
          "role": "steam_flow",
          "direction": "stuck",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.4,
          "note": "Steam flow unchanged while feedwater rises"
        },
        {
          "role": "makeup_flow",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            3600000
          ],
          "weight": 0.8
        },
        {
          "role": "acoustic",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.8,
          "note": "Acoustic leak detection often detects before the flow imbalance"
        },
        {
          "role": "furnace_pressure",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            3600000
          ],
          "weight": 0.4
        },
        {
          "role": "drum_level",
          "direction": "oscillate",
          "onset_lag_ms": [
            0,
            3600000
          ],
          "weight": 0.3
        },
        {
          "role": "flue_gas_temperature",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            3600000
          ],
          "weight": 0.3,
          "note": "Economiser leaks cool the flue gas"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "thin",
