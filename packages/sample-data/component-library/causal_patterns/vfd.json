      "title": "Current-limit foldback (speed reduction under load)",
      "category": "control",
      "severity": "warning",
      "description": "The load demands more current than the drive's current or torque limit. The drive holds current at the limit by lowering output frequency, so the motor runs below its reference speed. Pairs with induction_motor.mechanical_overload, whose driver propagation closes the same loop.",
      "typical_progression": "Seconds; persists while the overload persists.",
      "required_roles": [
        "current",
        "frequency"
      ],
      "optional_roles": [
        "current_limit_active",
        "speed",
        "speed_reference",
        "torque"
      ],
      "trigger_role": "current",
      "symptoms": [
        {
          "role": "current",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "threshold_hint": {
            "relative_to_nominal": 1.1
          },
          "note": "Current flat at the limit setting (commonly 110–150 % of rated)"
        },
        {
          "role": "current_limit_active",
          "direction": "trip",
          "onset_lag_ms": [
            0,
            500
          ],
          "weight": 0.9
        },
        {
