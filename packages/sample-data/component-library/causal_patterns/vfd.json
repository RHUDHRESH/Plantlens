          },
          {
            "id": "i",
            "label": "Output current ↑",
            "kind": "symptom",
            "role": "current"
          },
          {
            "id": "lim",
            "label": "Current limit active",
            "kind": "state",
            "role": "current_limit_active"
          },
          {
            "id": "f",
            "label": "Output frequency ↓",
            "kind": "symptom",
            "role": "frequency"
          },
          {
            "id": "n",
            "label": "Motor speed ↓",
            "kind": "symptom",
