  "patterns": [
    {
      "pattern_id": "vfd.dc_link_overvoltage_regen",
      "version": "1.0.0",
      "failure_mode": "dc_link_overvoltage_regen",
      "title": "DC-link overvoltage from regeneration",
      "category": "electrical",
      "severity": "warning",
      "description": "An overhauling load or a fast deceleration returns energy to the DC link. With no braking chopper, a failed chopper or an undersized resistor, DC-link voltage climbs to the overvoltage trip level.",
      "typical_progression": "Hundreds of milliseconds to seconds during a deceleration or an overhauling event.",
      "required_roles": [
        "dc_link_voltage"
      ],
      "optional_roles": [
        "frequency",
        "brake_chopper_duty",
        "drive_trip",
        "input_voltage",
        "current"
      ],
      "trigger_role": "dc_link_voltage",
      "symptoms": [
        {
          "role": "dc_link_voltage",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "threshold_hint": {
            "relative_to_nominal": 1.2
          },
          "note": "Nominal ≈ 1.35 × line voltage; 400 V drives typically trip near 800–820 V DC"
        },
        {
          "role": "frequency",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.6,
          "note": "Occurs during deceleration or with an overhauling load"
        },
        {
          "role": "brake_chopper_duty",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            500
          ],
          "weight": 0.6,
          "note": "Absent if no chopper is fitted or it has failed"
        },
        {
          "role": "drive_trip",
          "direction": "trip",
          "onset_lag_ms": [
            100,
            5000
          ],
          "weight": 0.7
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "regen",
            "label": "Regenerated power (decel / overhauling)",
            "kind": "cause"
          },
          {
            "id": "vdc",
            "label": "DC-link voltage ↑",
            "kind": "symptom",
            "role": "dc_link_voltage"
          },
          {
            "id": "ctrl",
            "label": "Overvoltage controller extends ramp",
            "kind": "state"
          },
          {
            "id": "chop",
            "label": "Brake chopper dissipates",
            "kind": "state",
            "role": "brake_chopper_duty"
          }
        ],
        "edges": [
          {
            "from": "regen",
            "to": "vdc",
            "sign": "+",
            "lag_ms": [
              0,
              1000
            ]
          },
          {
            "from": "vdc",
            "to": "ctrl",
            "sign": "+",
            "loop_id": "ov_control"
          },
          {
            "from": "ctrl",
            "to": "regen",
            "sign": "-",
            "loop_id": "ov_control"
          },
          {
            "from": "vdc",
            "to": "chop",
            "sign": "+",
            "loop_id": "chopper"
          },
          {
            "from": "chop",
            "to": "vdc",
            "sign": "-",
            "loop_id": "chopper"
          }
        ],
        "loops": [
          {
            "loop_id": "ov_control",
            "polarity": "balancing",
            "description": "The drive's overvoltage controller slows the deceleration to limit regenerated power."
          },
          {
            "loop_id": "chopper",
            "polarity": "balancing",
            "description": "The brake chopper switches the resistor in above its threshold to hold DC-link voltage."
          }
        ]
      },
      "propagation": [
        {
          "relation": "controlled",
          "effect_role": "speed",
          "direction": "fall",
          "polarity": "-",
          "lag_ms": [
            0,
            5000
          ],
          "edge_type": "control",
          "note": "After a trip the motor coasts"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "vfd.dc_link_undervoltage_supply_sag",
          "rule": "Supply overvoltage raises input voltage before the DC link; regeneration raises DC-link voltage with normal input voltage during deceleration.",
          "first_role": "input_voltage",
          "then_role": "dc_link_voltage"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Correlate trips with deceleration commands or overhauling load conditions.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check brake chopper enable setting, resistor resistance and thermal capacity.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Review deceleration ramp time against the load inertia.",
          "requires_isolation": false
        },
        {
          "order": 4,
          "text": "Check input voltage for high steady-state or switching overvoltages (capacitor bank switching).",
          "requires_isolation": false
        }
      ],
      "references": [
        "IEC 61800-2 (adjustable speed electrical power drive systems: ratings)",
        "IEC 61800-5-1 (safety)"
      ]
    },
    {
      "pattern_id": "vfd.dc_link_undervoltage_supply_sag",
      "version": "1.0.0",
      "failure_mode": "dc_link_undervoltage_supply_sag",
      "title": "DC-link undervoltage / supply sag",
      "category": "supply",
      "severity": "warning",
      "description": "A mains voltage sag, lost phase or weak supply lowers the DC-link voltage. The drive may ride through using load inertia (kinetic buffering) at reduced output frequency, or trip on undervoltage.",
      "typical_progression": "Milliseconds to seconds.",
      "required_roles": [
        "dc_link_voltage"
      ],
      "optional_roles": [
        "input_voltage",
        "frequency",
        "drive_trip",
        "ripple_voltage"
      ],
      "trigger_role": "dc_link_voltage",
      "symptoms": [
        {
          "role": "dc_link_voltage",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "threshold_hint": {
            "relative_to_nominal": 0.75
          },
          "note": "Undervoltage trip typically 65–75 % of nominal DC-link"
        },
        {
          "role": "input_voltage",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.9,
          "note": "Precedes the DC-link fall"
        },
        {
          "role": "frequency",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            1000
          ],
          "weight": 0.5,
          "note": "Kinetic buffering lowers frequency to regenerate from inertia"
        },
        {
          "role": "drive_trip",
          "direction": "trip",
          "onset_lag_ms": [
            10,
            2000
          ],
          "weight": 0.6
        },
        {
          "role": "ripple_voltage",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.4,
          "note": "A lost input phase raises ripple at 2× line frequency"
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "sag",
            "label": "Supply sag",
            "kind": "cause",
            "role": "input_voltage"
          },
          {
            "id": "vdc",
            "label": "DC-link voltage ↓",
            "kind": "symptom",
            "role": "dc_link_voltage"
          },
          {
            "id": "kb",
            "label": "Kinetic buffering lowers frequency",
            "kind": "state"
          },
          {
            "id": "regen",
            "label": "Energy from load inertia",
            "kind": "state"
          }
        ],
        "edges": [
          {
            "from": "sag",
            "to": "vdc",
            "sign": "+"
          },
          {
            "from": "vdc",
            "to": "kb",
            "sign": "-",
            "loop_id": "kinetic_buffer"
          },
          {
            "from": "kb",
            "to": "regen",
            "sign": "+",
            "loop_id": "kinetic_buffer"
          },
          {
            "from": "regen",
            "to": "vdc",
            "sign": "+",
            "loop_id": "kinetic_buffer"
          }
        ],
        "loops": [
          {
            "loop_id": "kinetic_buffer",
            "polarity": "balancing",
            "description": "The drive draws energy from the rotating load to hold the DC link, at the cost of speed."
          }
        ]
      },
      "propagation": [
        {
          "relation": "controlled",
          "effect_role": "speed",
          "direction": "fall",
          "polarity": "+",
          "lag_ms": [
            0,
            2000
          ],
          "edge_type": "control",
          "note": "Motor slows during ride-through or coasts after a trip"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "vfd.dc_link_capacitor_ageing",
          "rule": "Capacitor ageing raises ripple at normal mean DC voltage over months; a sag lowers the mean DC voltage for seconds."
        },
        {
          "vs_pattern": "dc_bus.overload_voltage_sag",
          "rule": "Common-DC-bus systems: a bus sag affects all drives on the bus at once."
        },
        {
          "vs_pattern": "induction_motor.undervoltage_supply",
          "rule": "Motor-side view; if the drive's own input voltage falls first, the supply is the origin."
        }
      ],
      "signatures": [
        {
          "domain": "waveform",
          "description": "Input voltage RMS dip depth and duration, compared with the drive ride-through curve (e.g. SEMI F47 / IEC 61000-4-34 profiles)"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Correlate with power-quality records on the incoming supply (sag depth and duration).",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Check all three input phases and input fuses; a single lost phase gives low DC-link at load.",
          "requires_isolation": false
        },
        {
          "order": 3,
          "text": "Review kinetic buffering / auto-restart parameters against process needs.",
          "requires_isolation": false
        }
      ],
      "references": [
        "IEC 61000-4-34 (voltage dip immunity)",
        "SEMI F47",
        "IEC 61800-3"
      ]
    },
    {
      "pattern_id": "vfd.overcurrent_trip",
      "version": "1.0.0",
      "failure_mode": "overcurrent_trip",
      "title": "Output overcurrent trip",
      "category": "electrical",
      "severity": "critical",
      "description": "Output current exceeds the instantaneous trip level (typically 2–3× rated peak) faster than the current limit can act: output short or ground fault, motor insulation failure, too-fast acceleration, catching a spinning load without flying start, or a sudden mechanical jam.",
      "typical_progression": "Microseconds to milliseconds.",
      "required_roles": [
        "current",
        "drive_trip"
      ],
      "optional_roles": [
        "frequency",
        "torque",
        "speed"
      ],
      "trigger_role": "current",
      "symptoms": [
        {
          "role": "current",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "threshold_hint": {
            "relative_to_nominal": 2.0
          },
          "note": "Captured as fault value; the logged RMS may understate the peak"
        },
        {
          "role": "drive_trip",
          "direction": "trip",
          "onset_lag_ms": [
            0,
            100
          ],
          "weight": 1.0
        },
        {
          "role": "torque",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            100
          ],
          "weight": 0.4
        }
      ],
      "propagation": [
        {
          "relation": "controlled",
          "effect_role": "speed",
          "direction": "fall",
          "polarity": "-",
          "lag_ms": [
            0,
            5000
          ],
          "edge_type": "control",
          "note": "Motor coasts after the trip"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "vfd.current_limit_foldback",
          "rule": "Current limit holds current near 1.5× rated for seconds with falling speed; overcurrent trips within milliseconds."
        },
        {
          "vs_pattern": "induction_motor.insulation_ground_fault",
          "rule": "A ground fault shows as an earth-fault trip or overcurrent with low insulation resistance on the motor or cable."
        },
        {
          "vs_pattern": "induction_motor.locked_rotor_stall",
          "rule": "A jam gives a current rise over tens of milliseconds with speed collapsing; a short gives an instantaneous peak at any speed."
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Read the fault log: trip current, frequency and whether it occurred during acceleration, running or start.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Megger the motor and cable from the drive output terminals with the drive disconnected.",
          "requires_isolation": true
        },
        {
          "order": 3,
          "text": "Check acceleration ramp time and flying-start setting against the application.",
          "requires_isolation": false
        },
        {
          "order": 4,
          "text": "Check the driven machine for a jam before restarting.",
          "requires_isolation": true
        }
      ],
      "references": [
        "IEC 61800-5-1"
      ]
    },
    {
      "pattern_id": "vfd.heatsink_overtemperature_fan_failure",
      "version": "1.0.0",
      "failure_mode": "heatsink_overtemperature_fan_failure",
      "title": "Heatsink overtemperature / cooling fan failure",
      "category": "thermal",
      "severity": "warning",
      "description": "The heatsink fan fails, the heatsink fins or filters clog, or the cabinet is too hot. Heatsink temperature rises at normal output current; the drive derates (switching frequency, current limit) and then trips.",
      "typical_progression": "Minutes (heatsink thermal time constant).",
      "required_roles": [
        "heatsink_temperature"
      ],
      "optional_roles": [
        "cooling_fan_speed",
        "cabinet_temperature",
        "current",
        "current_limit_active",
        "drive_trip"
      ],
      "trigger_role": "heatsink_temperature",
      "symptoms": [
        {
          "role": "heatsink_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 1.0,
          "note": "Alarm typically 5–10 °C below the drive's trip level"
        },
        {
          "role": "cooling_fan_speed",
          "direction": "fall",
          "onset_lag_ms": [
            0,
            0
          ],
          "weight": 0.8,
          "note": "Usually before the temperature rise when instrumented"
        },
        {
          "role": "cabinet_temperature",
          "direction": "rise",
          "onset_lag_ms": [
            0,
            1800000
          ],
          "weight": 0.4,
          "note": "When the cause is cabinet ventilation"
        },
        {
          "role": "current_limit_active",
          "direction": "trip",
          "onset_lag_ms": [
            60000,
            1800000
          ],
          "weight": 0.4,
          "note": "Thermal derating reduces the available current"
        },
        {
          "role": "drive_trip",
          "direction": "trip",
          "onset_lag_ms": [
            120000,
            3600000
          ],
          "weight": 0.5
        }
      ],
      "mechanism": {
        "nodes": [
          {
            "id": "fan",
            "label": "Fan failure / fins clogged",
            "kind": "cause",
            "role": "cooling_fan_speed"
          },
          {
            "id": "rth",
            "label": "Heatsink thermal resistance ↑",
            "kind": "state"
          },
          {
            "id": "ths",
            "label": "Heatsink temperature ↑",
            "kind": "symptom",
            "role": "heatsink_temperature"
          },
          {
            "id": "derate",
            "label": "Drive derates current / switching frequency",
            "kind": "state"
          },
          {
            "id": "loss",
            "label": "IGBT losses",
            "kind": "state"
          }
        ],
        "edges": [
          {
            "from": "fan",
            "to": "rth",
            "sign": "-"
          },
          {
            "from": "rth",
            "to": "ths",
            "sign": "+",
            "lag_ms": [
              60000,
              1800000
            ]
          },
          {
            "from": "ths",
            "to": "derate",
            "sign": "+",
            "loop_id": "thermal_derate"
          },
          {
            "from": "derate",
            "to": "loss",
            "sign": "-",
            "loop_id": "thermal_derate"
          },
          {
            "from": "loss",
            "to": "ths",
            "sign": "+",
            "loop_id": "thermal_derate"
          }
        ],
        "loops": [
          {
            "loop_id": "thermal_derate",
            "polarity": "balancing",
            "description": "Derating cuts IGBT losses to hold temperature, at the cost of available current and speed."
          }
        ]
      },
      "propagation": [
        {
          "relation": "controlled",
          "effect_role": "speed",
          "direction": "fall",
          "polarity": "+",
          "lag_ms": [
            60000,
            1800000
          ],
          "edge_type": "control",
          "note": "Derating can reduce speed under load"
        }
      ],
      "discriminators": [
        {
          "vs_pattern": "vfd.current_limit_foldback",
          "rule": "Cooling failure: heatsink temperature rises at normal current. Overload: current rises first.",
          "first_role": "cooling_fan_speed",
          "then_role": "heatsink_temperature"
        }
      ],
      "checks": [
        {
          "order": 1,
          "text": "Check the fan run status and fan hours against the manufacturer replacement interval.",
          "requires_isolation": false
        },
        {
          "order": 2,
          "text": "Clean heatsink fins and cabinet filters with the drive isolated and the DC link discharged.",
          "requires_isolation": true
        },
        {
          "order": 3,
          "text": "Check cabinet ventilation, air conditioning and ambient against the drive derating curve.",
          "requires_isolation": false
        }
      ],
      "references": [
        "IEC 61800-2 (ambient and derating)"
      ]
    },
    {
