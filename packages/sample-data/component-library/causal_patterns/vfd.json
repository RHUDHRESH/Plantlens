          },
          {
            "from": "lim",
            "to": "f",
            "sign": "-",
            "loop_id": "drive_current_limit"
          },
          {
            "from": "f",
            "to": "n",
            "sign": "+",
            "loop_id": "drive_current_limit"
          },
          {
            "from": "n",
            "to": "tl",
            "sign": "+",
            "loop_id": "drive_current_limit"
          },
          {
            "from": "tl",
            "to": "i",
